# Copy this file to .env and fill in values for your environment.
# .env is git-ignored — never commit real credentials.

# ── Logging ──────────────────────────────────────────────────────────────────
# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── FrameStore ───────────────────────────────────────────────────────────────
# Frames not consumed by inference within this many seconds are evicted.
FRAME_TTL_SEC=5.0

# ── Camera (RTSP only) ───────────────────────────────────────────────────────
# Required when config.yaml has stream.type=rtsp.
# Format: rtsp://user:password@host:port/path
RTSP_URL=rtsp://admin:changeme@192.168.1.100:554/stream

# ── PostgreSQL database ───────────────────────────────────────────────────────
# Option A — provide a full SQLAlchemy URL (recommended).
# IMPORTANT: URL-encode special characters in the password.
#   @ → %40   # → %23   : → %3A
# Example with password "Postgres@123":
DATABASE_URL=postgresql+psycopg2://Postgres:Postgres%40123@localhost:5433/bh_cv

# Option B — individual components (used by build_database_url() if DATABASE_URL is not set).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USERNAME=Postgres
POSTGRES_PASSWORD=Postgres@123
POSTGRES_DB=bh_cv

# ── Redis ─────────────────────────────────────────────────────────────────────
# Required when runtime.message_queue_backend=redis or runtime.frame_store_backend=redis.
# Format: redis://[[user]:password@]host[:port][/db]
# For TLS: rediss://...
# NEVER commit real credentials.
REDIS_URL=redis://localhost:6379/0
